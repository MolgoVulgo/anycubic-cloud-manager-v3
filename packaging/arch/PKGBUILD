pkgname=anycubic-cloud-manager-v3
pkgver=0.85-1
pkgrel=1
pkgdesc="Anycubic Cloud Manager V3 (Qt6/QML)"
arch=('x86_64')
url="https://github.com/MolgoVulgo/anycubic-cloud-manager-v3/releases/latest"
license=('MIT')
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-5compat'
  'qt6-shadertools'
  'qt6-quick3d'
  'qt6-mqtt'
  'openssl'
)
makedepends=(
  'cmake'
  'ninja'
  'pkgconf'
  'gcc'
)
source=(
  "${pkgname}-${pkgver}.zip::https://github.com/MolgoVulgo/anycubic-cloud-manager-v3/archive/refs/tags/v${pkgver}.zip"
)
sha256sums=(
  'SKIP'
)

build() {
  local _repo_dir="${srcdir}/${pkgname}-${pkgver}"
  local _srcdir="${_repo_dir}/accloud"
  cd "${_srcdir}"
  cmake --preset prod
  cmake --build --preset prod --target accloud_cli
}

package() {
  local _repo_dir="${srcdir}/${pkgname}-${pkgver}"
  local _srcdir="${_repo_dir}/accloud"
  cd "${_repo_dir}"

  install -d "${pkgdir}/opt/accloud"
  install -m755 "${_srcdir}/build/prod/accloud_cli" "${pkgdir}/opt/accloud/accloud_cli"

  if [[ -d "${_repo_dir}/resources" ]]; then
    cp -r "${_repo_dir}/resources" "${pkgdir}/opt/accloud/resources"
  fi

  install -d "${pkgdir}/usr/share/applications"
  install -m644 "packaging/arch/accloud.desktop" "${pkgdir}/usr/share/applications/accloud.desktop"

  install -d "${pkgdir}/usr/share/metainfo"
  install -m644 "packaging/org.accloud.App.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/org.accloud.App.metainfo.xml"

  install -d "${pkgdir}/var/log/accloud"
}
